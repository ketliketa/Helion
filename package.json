{
  "name": "hotelflow-pms",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "test": "node --test tests/*.test.ts",
    "format": "prettier --write src server scripts tests vite.config.ts index.html package.json",
    "check": "tsc --noEmit",
    "backup": "node --env-file-if-exists=.env scripts/backup.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "docx": "9.6.1",
    "lucide-react": "1.31.0",
    "pdf-lib": "1.17.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
