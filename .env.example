# Node.js 24. Run npm install then npm run dev.
PORT=3001
APP_URL=http://localhost:5173
DATA_DIR=./data
NODE_ENV=development

# Online payments and subscriptions require your own eligible Stripe account.
# Stripe Connect is required to collect money for different accommodation owners.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Email delivery. Without keys, emails remain visibly queued, never marked sent.
RESEND_API_KEY=
MAIL_FROM=
